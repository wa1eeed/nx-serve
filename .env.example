# NX Serve environment variables. Copy to .env for local dev. Never commit real secrets.
# Secrets come from the environment (Coolify / Alibaba KMS) in staging and production.

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=debug

# --- API ---
API_PORT=3001
API_PUBLIC_URL=http://localhost:3001
# Comma separated list of base domains used to resolve tenants from the Host header.
PLATFORM_DOMAIN=localhost
PLATFORM_STAGING_DOMAIN=

# --- Database (PostgreSQL 16 + PostGIS 3) ---
# The application connects as a NON OWNER role (RLS enforced).
DATABASE_URL=postgres://nxserve_app:nxserve_app@localhost:5544/nxserve
# The owner/migration role runs migrations only (DDL), never serves requests.
DATABASE_MIGRATION_URL=postgres://nxserve_owner:nxserve_owner@localhost:5544/nxserve
# The super admin role has BYPASSRLS and is used only by the platform admin backend, audited.
DATABASE_SUPERADMIN_URL=postgres://nxserve_superadmin:nxserve_superadmin@localhost:5544/nxserve

# --- Redis 7 (BullMQ, Socket.IO adapter, GEO, rate limits, cache) ---
REDIS_URL=redis://localhost:6379

# --- Realtime ---
REALTIME_PORT=3002

# --- Auth ---
# Rotate these; use strong random values in every environment.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
OTP_TTL_SECONDS=300
# argon2id cost parameters are set in code; MFA uses TOTP.

# --- Object storage (S3 compatible: MinIO locally, Alibaba OSS in production) ---
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=nxserve-local
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true

# --- Email (Mailpit locally) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@localhost

# --- Payment gateway (Moyasar). Payments stay sandbox only and behind a feature flag ---
# until the Split Payments addendum is signed (docs/16 Q1, Q6). The gateway is replaceable.
PAYMENTS_ENABLED=false
PAYMENT_GATEWAY=fake
MOYASAR_API_BASE=https://api.moyasar.com
MOYASAR_SECRET_KEY=
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_WEBHOOK_SHARED_SECRET=

# --- Maps (behind MapsProvider; fake locally) ---
MAPS_PROVIDER=fake
GOOGLE_MAPS_API_KEY=

# --- Notifications (behind NotificationProvider; console/log locally) ---
NOTIFICATIONS_PROVIDER=console

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# --- Marketing site (apps/marketing) ---
# Public site origin, used for canonical URLs, hreflang, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://nxserve.com
NEXT_PUBLIC_DEVELOPERS_URL=https://developers.nxserve.com
# CRM webhook that receives demo-request leads. If empty, leads are logged server side.
DEMO_WEBHOOK_URL=
# Analytics (GA4, optional; loads only after consent). Client measurement id:
NEXT_PUBLIC_GA_ID=
# GA4 Measurement Protocol for server-side conversion events (optional):
GA_MEASUREMENT_ID=
GA_API_SECRET=
# Comma-separated source IP allowlist for gateway webhooks (empty = no IP check):
WEBHOOK_ALLOWED_IPS=
