{
  "name": "@nxserve/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/cli/migrate.ts up",
    "seed": "tsx src/cli/seed.ts",
    "reset": "tsx src/cli/migrate.ts reset && tsx src/cli/seed.ts",
    "pull": "drizzle-kit pull",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@nxserve/contracts": "workspace:*",
    "@nxserve/domain": "workspace:*",
    "pg": "8.13.1"
  },
  "devDependencies": {
    "@nxserve/config": "workspace:*",
    "@testcontainers/postgresql": "10.16.0",
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "drizzle-kit": "0.30.1",
    "drizzle-orm": "0.38.3",
    "eslint": "9.17.0",
    "testcontainers": "10.16.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
